# ---------------------------------------------------------------------------
# Supabase (create at https://supabase.com — Joshua must create this project)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key is server-only (cron + job upserts). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Cron (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
# ---------------------------------------------------------------------------
CRON_SECRET=generate-a-long-random-string

# ---------------------------------------------------------------------------
# Optional ATS tuning
# ---------------------------------------------------------------------------
# ATS_FETCH_DELAY_MS=350
# ATS_MAX_RETRIES=2

# Optional: override the built-in company allowlist with JSON array
# COMPANY_ALLOWLIST_JSON=[{"name":"Figma","provider":"greenhouse","boardToken":"figma"}]
